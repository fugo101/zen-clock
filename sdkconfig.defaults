# Critical non-default settings required for zen-clock firmware.
# ESP-IDF auto-applies this file when generating a fresh sdkconfig.

# mbedTLS: ChaCha20-Poly1305 (required by microlink/WireGuard Noise protocol)
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# Bluetooth: BLE 4.2 legacy GAP (ESP32-S3 defaults to BLE 5.0)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# BLE provisioning: SRP6a security (protocomm)
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y

# LVGL: QR code widget (required for BLE provisioning screen)
CONFIG_LV_USE_QRCODE=y
